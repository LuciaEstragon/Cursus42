### Ejercicio 0: lambda_spells.py

```python
# lambda_spells.py
# Ejercicio 0: Lambda Sanctum

from typing import List, Dict, Any

def artifact_sorter(artifacts: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """
    Ordena artefactos por nivel de poder (descendente) usando lambda.
    """
    return sorted(artifacts, key=lambda a: a['power'], reverse=True)


def power_filter(mages: List[Dict[str, Any]], min_power: int) -> List[Dict[str, Any]]:
    """
    Filtra magos con poder >= min_power usando lambda con filter().
    """
    return list(filter(lambda m: m['power'] >= min_power, mages))


def spell_transformer(spells: List[str]) -> List[str]:
    """
    Transforma nombres de hechizos añadiendo "* " al inicio y " *" al final.
    """
    return list(map(lambda s: f"* {s} *", spells))


def mage_stats(mages: List[Dict[str, Any]]) -> Dict[str, float]:
    """
    Calcula estadísticas de poder de los magos usando lambdas.
    """
    if not mages:
        return {'max_power': 0, 'min_power': 0, 'avg_power': 0.0}
    
    powers = [m['power'] for m in mages]
    max_power = max(powers, key=lambda p: p)
    min_power = min(powers, key=lambda p: p)
    avg_power = round(sum(powers) / len(powers), 2)
    
    return {'max_power': max_power, 'min_power': min_power, 'avg_power': avg_power}


# Código de demostración (no obligatorio para la entrega)
if __name__ == "__main__":
    # Prueba de artifact_sorter
    artifacts = [
        {'name': 'Crystal Orb', 'power': 85, 'type': 'orb'},
        {'name': 'Fire Staff', 'power': 92, 'type': 'staff'},
        {'name': 'Shadow Dagger', 'power': 70, 'type': 'dagger'}
    ]
    sorted_artifacts = artifact_sorter(artifacts)
    print("Testing artifact sorter...")
    for a in sorted_artifacts:
        print(f"{a['name']} ({a['power']} power)")
    
    # Prueba de spell_transformer
    spells = ['fireball', 'heal', 'shield']
    transformed = spell_transformer(spells)
    print("\nTesting spell transformer...")
    print(' '.join(transformed))
```

### Ejercicio 1: higher_magic.py

```python
# higher_magic.py
# Ejercicio 1: Higher Realm

from typing import Callable, Tuple, List, Any

def spell_combiner(spell1: Callable[[str, int], str], 
                   spell2: Callable[[str, int], str]) -> Callable[[str, int], Tuple[str, str]]:
    """
    Combina dos hechizos. Devuelve una función que llama a ambos
    con los mismos argumentos y devuelve una tupla con los resultados.
    """
    def combined(target: str, power: int) -> Tuple[str, str]:
        return (spell1(target, power), spell2(target, power))
    return combined


def power_amplifier(base_spell: Callable[[str, int], str], 
                    multiplier: int) -> Callable[[str, int], str]:
    """
    Amplifica el poder de un hechizo multiplicándolo antes de lanzarlo.
    """
    def amplified(target: str, power: int) -> str:
        return base_spell(target, power * multiplier)
    return amplified


def conditional_caster(condition: Callable[[str, int], bool], 
                       spell: Callable[[str, int], str]) -> Callable[[str, int], str]:
    """
    Lanza el hechizo solo si la condición se cumple.
    Si no, devuelve "Spell fizzled".
    """
    def conditional(target: str, power: int) -> str:
        if condition(target, power):
            return spell(target, power)
        return "Spell fizzled"
    return conditional


def spell_sequence(spells: List[Callable[[str, int], str]]) -> Callable[[str, int], List[str]]:
    """
    Crea una secuencia de hechizos. Devuelve una función que lanza
    todos los hechizos en orden con los mismos argumentos.
    """
    def sequence(target: str, power: int) -> List[str]:
        return [spell(target, power) for spell in spells]
    return sequence


# Código de demostración (no obligatorio para la entrega)
if __name__ == "__main__":
    # Definimos algunos hechizos de ejemplo
    def fireball(target: str, power: int) -> str:
        return f"Fireball hits {target} for {power} damage"
    
    def heal(target: str, power: int) -> str:
        return f"Heal restores {target} for {power} HP"
    
    # Prueba de spell_combiner
    combined_spell = spell_combiner(fireball, heal)
    print("Testing spell combiner...")
    result = combined_spell("Dragon", 50)
    print(f"Combined spell result: {result[0]}, {result[1]}")
    
    # Prueba de power_amplifier
    amplified_fireball = power_amplifier(fireball, 3)
    print("\nTesting power amplifier...")
    original = fireball("Goblin", 10)
    amplified = amplified_fireball("Goblin", 10)
    print(f"Original: {original}")
    print(f"Amplified: {amplified}")
    
    # Prueba de conditional_caster
    def is_strong_enough(target: str, power: int) -> bool:
        return power >= 20
    
    conditional_heal = conditional_caster(is_strong_enough, heal)
    print("\nTesting conditional caster...")
    print(conditional_heal("Warrior", 15))
    print(conditional_heal("Warrior", 25))
    
    # Prueba de spell_sequence
    spell_list = [fireball, heal]
    sequence_spell = spell_sequence(spell_list)
    print("\nTesting spell sequence...")
    results = sequence_spell("Orc", 30)
    for r in results:
        print(r)
